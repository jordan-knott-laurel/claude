# Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Intercom app OAuth client secret (for verifying webhook signatures)
INTERCOM_CLIENT_SECRET=your-client-secret

# Optional: Claude model to use (defaults to claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: Custom system prompt for Laurel's Claude instance
LAUREL_SYSTEM_PROMPT=

# Port to run the server on (defaults to 3000)
PORT=3000
